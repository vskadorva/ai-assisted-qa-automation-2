# =============================================================================
# Run tests (required to clone and run Playwright)
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Base URL of the Didaxis environment under test (e.g. staging)
DIDAXIS_URL=https://test.didaxis.studio

# Primary admin account — used by auth.setup.ts and most UI tests
DIDAXIS_EMAIL=your-admin@example.com

# Password for DIDAXIS_EMAIL
DIDAXIS_PASSWORD=your-admin-password

# Bearer token for REST API calls (program cleanup, setup helpers).
# Obtain from Didaxis or via POST /api/auth/login; falls back to email/password if unset.
DIDAXIS_API_TOKEN=your-didaxis-api-bearer-token

# --- Optional: secondary account for permission / role probes ---

# Non-admin or alternate-role email (only needed for permission-specific tests)
# DIDAXIS_ALT_EMAIL=your-viewer@example.com

# Password for DIDAXIS_ALT_EMAIL
# DIDAXIS_ALT_PASSWORD=your-viewer-password

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# Used by the headless Cursor agent workflow and Jira/MCP integrations.
# =============================================================================

# Cursor API key — required for `agent -p` in .github/workflows/test-generation.yml
CURSOR_API_KEY=your-cursor-api-key

# Atlassian Cloud API token (https://id.atlassian.com/manage-profile/security/api-tokens)
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Atlassian site URL (no trailing slash)
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=your-jira@example.com
